record exprim.papercut.akr-change-begin-related-decision-rejects-non/1 : papercut {
    title "akr change begin --related <decision> rejects non-work records as…"
    state verified
    statement """
        akr change begin --related <decision> rejects non-work records as AKR-C032, yet akr change prepare --staged without --primary fails with AKR-C032 calling the staged decision, observation, and papercut 'work records' and asking for --primary.
        """
    observed_at git:a426fa7d98ee1ff1749aa6c9178ad34ffa7d6554
    author "antigravity"
    created_at 2026-11-27
}

