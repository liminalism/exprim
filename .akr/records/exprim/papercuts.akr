record exprim.papercut.ran-akr-explain-plan-after-reading-agents-md/1 : papercut {
    title "Ran 'akr explain plan' after reading AGENTS.md ('Replacing a plan...…"
    state verified
    statement """
        Ran 'akr explain plan' after reading AGENTS.md ('Replacing a plan... Unsure what a kind requires? akr explain <kind>'), which failed with AKR-C004 because 'plan' is prose shorthand rather than a record kind; listing valid kinds in AKR-C004 help or AGENTS.md would avoid a retry.
        """
    observed_at git:9cb999b02eeb7c82194757c2e5fdcdef46a32b50
    author "antigravity"
    created_at 2026-11-24
}
