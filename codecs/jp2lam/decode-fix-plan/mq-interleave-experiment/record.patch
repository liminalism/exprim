 pub(crate) const MQC_NUMCTXS: usize = 19;
 
+/// Experiment support (decode-fix-plan/mq-interleave-experiment): records
+/// every decoder's bytes and every decision's context and bit.
+#[cfg(feature = "mq-trace")]
+pub mod trace {
+    use std::cell::RefCell;
+    #[derive(Default)]
+    pub struct Segment {
+        pub bytes: Vec<u8>,
+        pub contexts: Vec<u8>,
+        pub bits: Vec<u8>,
+        /// Started from the initial context states (not a continuation).
+        pub fresh: bool,
+    }
+    thread_local! {
+        pub static SEGMENTS: RefCell<Vec<Segment>> = const { RefCell::new(Vec::new()) };
+    }
+    pub(crate) fn record(ctx: u8, bit: u8) {
+        SEGMENTS.with(|segments| {
+            let mut segments = segments.borrow_mut();
+            let segment = segments.last_mut().unwrap();
+            segment.contexts.push(ctx);
+            segment.bits.push(bit);
+        });
+    }
+}
+
 pub(crate) const BYPASS_CT_INIT: u32 = 0xDEAD_BEEF;
 
 pub(crate) const T1_CTXNO_ZC: u8 = 0;
