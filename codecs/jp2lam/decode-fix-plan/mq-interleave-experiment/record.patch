@@ -0,0 +1,33 @@
+//! record <in.jp2|in.j2k> <out.trace>: decode on the calling thread and dump
+//! every MQ codeword segment as
+//! `u32 byte count, u32 symbol count, bytes, contexts, bits` (little endian).
+use jp2lam::{DecodeConcurrency, DecodeRequest, Jp2Decoder};
+use std::io::Write;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let bytes = std::fs::read(&args[1]).unwrap();
+    let request = DecodeRequest {
+        concurrency: DecodeConcurrency::Serial,
+        ..Default::default()
+    };
+    Jp2Decoder::new().decode(&bytes, &request).unwrap();
+    let segments = jp2lam::mq::trace::SEGMENTS.with(|s| std::mem::take(&mut *s.borrow_mut()));
+    let mut out = std::io::BufWriter::new(std::fs::File::create(&args[2]).unwrap());
+    let (mut kept, mut symbols, mut skipped) = (0u64, 0u64, 0u64);
+    for segment in &segments {
+        // The replay starts every decoder from the initial context states.
+        if !segment.fresh || segment.contexts.is_empty() {
+            skipped += 1;
+            continue;
+        }
+        out.write_all(&(segment.bytes.len() as u32).to_le_bytes()).unwrap();
+        out.write_all(&(segment.contexts.len() as u32).to_le_bytes()).unwrap();
+        out.write_all(&segment.bytes).unwrap();
+        out.write_all(&segment.contexts).unwrap();
+        out.write_all(&segment.bits).unwrap();
+        kept += 1;
+        symbols += segment.contexts.len() as u64;
+    }
+    eprintln!("{}: {kept} segments, {symbols} symbols, {skipped} skipped", args[1]);
+}
