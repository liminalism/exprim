+/// Whether a block can be decoded a column at a time by a [`Lane`]: its
+/// codeword is a single MQ segment with nothing to do between passes. That
+/// is every block of a stream coded without the code-block style switches.
+fn lane_decodable(style: CodeBlockStyle, block: &super::t2::DecodedCodeBlock<'_>) -> bool {
+    block.segments.len() == 1
+        && !style.bypass
+        && !style.reset_contexts
+        && !style.terminate_each_pass
+        && !style.segmentation_symbols
+}
+
+/// Decode the blocks `next_block` hands out, writing each into its plane
+/// rectangle. Two blocks are in progress at a time where their coding
+/// allows; the others are decoded whole, one at a time.
+fn decode_blocks<'p>(
+    header: &CodestreamHeader,
+    blocks: &'p [super::t2::DecodedCodeBlock<'p>],
+    planes: &BlockPlanes,
+    scratch: &mut Tier1Workspace,
+    mut next_block: impl FnMut() -> Option<usize>,
+) -> Result<()> {
+    let style = header.cod.code_block_style;
+    let [scratch_a, scratch_b] = &mut scratch.lanes;
+    let mut a = Lane::idle(scratch_a);
+    let mut b = Lane::idle(scratch_b);
+    let mut exhausted = false;
+    loop {
+        for (lane, enabled) in [(&mut a, true), (&mut b, INTERLEAVE_BLOCKS)] {
+            while enabled && lane.block.is_none() && !exhausted {
+                let Some(index) = next_block() else {
+                    exhausted = true;
+                    break;
+                };
+                let block = &blocks[index];
+                let params = block_params(header, block)?;
+                if lane_decodable(style, block) {
+                    lane.begin(index, block, &params, style)?;
+                } else {
+                    decode_codeblock_segments_into(
+                        params.block_width,
+                        params.block_height,
+                        block.band,
+                        params.max_bitplanes,
+                        block.zero_bitplanes,
+                        block.passes,
+                        style,
+                        &block.segments,
+                        lane.scratch,
+                        &mut StatsSink::disabled(),
+                    )?;
+                    // SAFETY: as for the lanes' writes below.
+                    unsafe {
+                        planes.write_block(
+                            block.component,
+                            block.x0 as usize,
+                            block.y0 as usize,
+                            lane.scratch,
+                            params.step,
+                        )?;
+                    }
                 }
-                pending &= pending - 1;
             }
-            s.mid[x + 1] = word & !T1_PI_ALL;
+        }
+        if a.active() && b.active() {
+            run_pair(&mut a, &mut b);
+        } else if exhausted || !INTERLEAVE_BLOCKS {
+            run_solo(&mut a);
+            run_solo(&mut b);
+        }
+        for lane in [&mut a, &mut b] {
+            if let Some(index) = lane.block
+                && !lane.active()
+            {
+                let block = &blocks[index];
+                // SAFETY: code blocks tile pairwise-disjoint rectangles of
+                // each component plane, and every block is handed out once,
+                // so no two writes overlap, on this thread or another.
+                unsafe {
+                    planes.write_block(
+                        block.component,
+                        block.x0 as usize,
+                        block.y0 as usize,
+                        lane.scratch,
+                        lane.step,
+                    )?;
+                }
+                lane.block = None;
+            }
+        }
+        if exhausted && a.block.is_none() && b.block.is_none() {
+            return Ok(());
         }
     }
