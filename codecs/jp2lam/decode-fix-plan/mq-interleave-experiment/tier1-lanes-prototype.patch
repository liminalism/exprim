+/// Decode the rest of lane `a`'s current stripe.
+#[inline(never)]
+fn solo_columns<A: ColumnKernel>(a: &mut Lane<'_, '_>) {
+    let columns = a.columns_left();
+    let first = a.x;
+    let (width, height) = (a.scratch.width, a.scratch.height);
+    let mut stripe = Stripe::new(
+        &mut a.scratch.flags,
+        &mut a.scratch.coefficients,
+        a.stripe,
+        width,
+        height,
+    );
+    for x in first..first + columns {
+        A::column(&mut a.decoder, &mut stripe, x, &a.consts);
+    }
+    a.advance(columns);
+}
+
+/// Decode as many columns as both lanes have left in their current stripes,
+/// one column of each in turn. The two blocks' arithmetic decoders are
+/// independent, so a processor can overlap one block's decisions with the
+/// other's instead of waiting on a single chain of them.
+#[inline(never)]
+fn pair_columns<A: ColumnKernel, B: ColumnKernel>(a: &mut Lane<'_, '_>, b: &mut Lane<'_, '_>) {
+    let columns = a.columns_left().min(b.columns_left());
+    let (first_a, first_b) = (a.x, b.x);
+    let (width_a, height_a) = (a.scratch.width, a.scratch.height);
+    let (width_b, height_b) = (b.scratch.width, b.scratch.height);
+    let mut stripe_a = Stripe::new(
+        &mut a.scratch.flags,
+        &mut a.scratch.coefficients,
+        a.stripe,
+        width_a,
+        height_a,
+    );
+    let mut stripe_b = Stripe::new(
+        &mut b.scratch.flags,
+        &mut b.scratch.coefficients,
+        b.stripe,
+        width_b,
+        height_b,
+    );
+    // Local copies, so the optimiser is free to keep both decoders' registers
+    // in machine registers for the whole run.
+    let (mut decoder_a, mut decoder_b) = (a.decoder.clone(), b.decoder.clone());
+    let (consts_a, consts_b) = (a.consts, b.consts);
+    for i in 0..columns {
+        A::column(&mut decoder_a, &mut stripe_a, first_a + i, &consts_a);
+        B::column(&mut decoder_b, &mut stripe_b, first_b + i, &consts_b);
+    }
+    a.decoder = decoder_a;
+    b.decoder = decoder_b;
+    a.advance(columns);
+    b.advance(columns);
+}
+
+/// Advance one lane until its block is decoded.
+fn run_solo(a: &mut Lane<'_, '_>) {
+    while a.active() {
+        match a.kind {
+            PassKind::Significance => solo_columns::<SignificancePass>(a),
+            PassKind::Refinement => solo_columns::<RefinementPass>(a),
+            PassKind::Cleanup => solo_columns::<CleanupPass>(a),
+        }
+    }
+}
+
+/// Advance both lanes until either block is decoded.
+fn run_pair(a: &mut Lane<'_, '_>, b: &mut Lane<'_, '_>) {
+    use PassKind::{Cleanup, Refinement, Significance};
+    while a.active() && b.active() {
+        match (a.kind, b.kind) {
+            (Significance, Significance) => {
+                pair_columns::<SignificancePass, SignificancePass>(a, b)
+            }
+            (Significance, Refinement) => pair_columns::<SignificancePass, RefinementPass>(a, b),
+            (Significance, Cleanup) => pair_columns::<SignificancePass, CleanupPass>(a, b),
+            (Refinement, Significance) => pair_columns::<RefinementPass, SignificancePass>(a, b),
+            (Refinement, Refinement) => pair_columns::<RefinementPass, RefinementPass>(a, b),
+            (Refinement, Cleanup) => pair_columns::<RefinementPass, CleanupPass>(a, b),
+            (Cleanup, Significance) => pair_columns::<CleanupPass, SignificancePass>(a, b),
+            (Cleanup, Refinement) => pair_columns::<CleanupPass, RefinementPass>(a, b),
+            (Cleanup, Cleanup) => pair_columns::<CleanupPass, CleanupPass>(a, b),
+        }
+    }
+}
