# build.rs checks the SHA-256 of the vendored PDFium sources byte for byte, so
# no checkout may convert their line endings (core.autocrlf=true would).
upstream/** -text
# Binary data embedded with include_bytes!.
*.otf binary
src/font/cmap_data/** binary
*.pdf binary
*.jpg binary
*.bin binary

# The AKR ledger is LF-only (AKR-P003); keep autocrlf from rewriting it.
.akr/** text eol=lf
